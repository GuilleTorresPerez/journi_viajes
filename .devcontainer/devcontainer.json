{
  "name": "Flutter Project",
  // Usamos una imagen mantenida por la comunidad que ya tiene Flutter y Android tools
  "image": "ghcr.io/cirruslabs/flutter:stable",

  // Configuraciones de VS Code dentro del contenedor
  "customizations": {
    "vscode": {
      "extensions": [
        "Dart-Code.flutter",
        "Dart-Code.dart-code"
      ]
    }
  },

  // Comando para bajar dependencias al arrancar
  "postCreateCommand": "cd journi && flutter pub get --no-precompile",

  // Importante para Linux: usar el usuario root para evitar líos de permisos al principio
  "remoteUser": "root"
}